<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
   <children>
      <Pane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #E6D7FF;">
         <children>
            <Label layoutX="198.0" layoutY="28.0" prefHeight="42.0" prefWidth="230.0" text="Cadastrar Livros">
               <font>
                  <Font name="Yuppy SC Regular" size="30.0" />
               </font>
            </Label>
            <TableView fx:id="tabelaLivros" layoutX="48.0" layoutY="215.0" onMouseClicked="#selecionarLivro" prefHeight="161.0" prefWidth="406.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="38.0" text="Id" />
                <TableColumn fx:id="colTitulo" prefWidth="138.0" text="Titulo" />
                  <TableColumn fx:id="colAutor" prefWidth="143.0" text="Autor" />
                  <TableColumn fx:id="colAno" prefWidth="86.0" text="Ano" />
              </columns>
            </TableView>
            <VBox layoutX="487.0" layoutY="104.0" prefHeight="190.0" prefWidth="78.0" spacing="15.0">
               <children>
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#btnLimparAction" prefHeight="26.0" prefWidth="77.0" style="-fx-background-color: #C8A2C8;" text="Limpar" />
                  <Button fx:id="btnCadastrar" mnemonicParsing="false" onAction="#btnCadastrarAction" prefHeight="26.0" prefWidth="73.0" style="-fx-background-color: #C8A2C8;" text="Cadastrar" />
                  <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#btnAtualizarAction" prefHeight="26.0" prefWidth="73.0" style="-fx-background-color: #C8A2C8;" text="Atualizar" />
                  <Button fx:id="btnApagar" mnemonicParsing="false" onAction="#btnApagarAction" prefHeight="26.0" prefWidth="73.0" style="-fx-background-color: #C8A2C8;" text="Apagar" />
                  <Button fx:id="btnListar" mnemonicParsing="false" onAction="#btnListarAction" prefHeight="26.0" prefWidth="73.0" style="-fx-background-color: #C8A2C8;" text="Listar" />
               </children>
            </VBox>
            <VBox layoutX="143.0" layoutY="108.0" prefHeight="50.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <TextField fx:id="txtId" prefHeight="26.0" prefWidth="126.0" />
                  <TextField fx:id="txtAno" prefHeight="26.0" prefWidth="126.0" />
               </children>
            </VBox>
            <VBox layoutX="321.0" layoutY="108.0" prefHeight="50.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <TextField fx:id="txtTitulo" prefHeight="26.0" prefWidth="126.0" />
                  <TextField fx:id="txtAutor" prefHeight="26.0" prefWidth="126.0" />
               </children>
            </VBox>
            <Label layoutX="121.0" layoutY="108.0" prefHeight="17.0" prefWidth="20.0" text="ID:" />
            <Label layoutX="278.0" layoutY="117.0" prefHeight="17.0" prefWidth="37.0" text="Título:" />
            <Label layoutX="278.0" layoutY="148.0" prefHeight="17.0" prefWidth="37.0" text="Autor:" />
            <Label layoutX="53.0" layoutY="148.0" prefHeight="17.0" prefWidth="104.0" text="Ano Publicação:" />
         </children>
      </Pane>
   </children>
</AnchorPane>
